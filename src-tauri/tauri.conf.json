{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KaizerHUD Studio",
  "version": "1.0.1",
  "identifier": "xyz.kaizermc.hudmaker",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:8765"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KaizerHUD Studio",
        "width": 1600,
        "height": 950,
        "minWidth": 1100,
        "minHeight": 680,
        "maximized": true,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#1b1b1b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZERUM2RkQyRTBCQTk5NjMKUldSam1icmcwbS9zL1NGVXhaRVNmYmFNR1E2UDQ4L3M1a3NOeWJIc3U1MUlNZWxIZ2N2dXhFQTgK",
      "endpoints": [
        "https://github.com/tomzangsad/KaizerHUD-Studio/releases/latest/download/latest.json"
      ]
    }
  }
}