{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KaizerHUD Studio",
  "version": "1.0.0",
  "identifier": "xyz.kaizermc.hudmaker",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:8765"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KaizerHUD Studio",
        "width": 1600,
        "height": 950,
        "minWidth": 1100,
        "minHeight": 680,
        "maximized": true,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#1b1b1b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}